{
  "schema": "peninsula.datasource/v1",
  "id": "open-meteo-shanghai-temperature",
  "name": "上海实时气温",
  "description": "读取 Open-Meteo 当前 2 米气温。可在参数中修改经纬度；默认位置为上海。",
  "icon": {
    "mime": "image/svg+xml",
    "base64": ""
  },
  "inputs": {
    "latitude": {
      "type": "number",
      "label": "纬度",
      "default": 31.2304,
      "required": true,
      "min": -90,
      "max": 90
    },
    "longitude": {
      "type": "number",
      "label": "经度",
      "default": 121.4737,
      "required": true,
      "min": -180,
      "max": 180
    },
    "alert_threshold": {
      "type": "number",
      "label": "高温提醒阈值（°C）",
      "description": "可将阈值调低到当前温度以下，验证提醒。",
      "default": 35,
      "required": true,
      "min": -50,
      "max": 60
    }
  },
  "request": {
    "method": "GET",
    "url": "https://api.open-meteo.com/v1/forecast",
    "query": {
      "latitude": "${input.latitude}",
      "longitude": "${input.longitude}",
      "current": "temperature_2m",
      "timezone": "auto"
    },
    "timeout_ms": 10000
  },
  "value": {
    "path": "$.current.temperature_2m",
    "type": "number",
    "multiply": 1,
    "divide": 1,
    "offset": 0,
    "decimals": 1,
    "separator": false,
    "prefix": "",
    "suffix": " °C"
  },
  "alert": {
    "operator": "gte",
    "threshold": "${input.alert_threshold}",
    "title": "上海高温提醒",
    "message": "当前气温 ${value}，已达到设定阈值。"
  }
}
